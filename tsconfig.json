{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Los mocks de Orval (faker + MSW) no se usan en los tests y no cumplen `exactOptionalPropertyTypes`.
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "src/shared/api/generated/**/*.faker.ts",
    "src/shared/api/generated/**/*.msw.ts"
  ]
}
