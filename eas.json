{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_ENV": "development", "API_URL": "http://192.168.0.34:3000" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_ENV": "preview", "API_URL": "https://api-staging.yoclick.app" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "API_URL": "https://api.yoclick.app" }
    }
  },
  "submit": { "production": {} }
}
